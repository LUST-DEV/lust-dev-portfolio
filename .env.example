# Frontend public site key. It is injected at build time only when a protected form is added.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Server-only secret. Never prefix this with VITE_ and never expose it to the browser.
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Optional Google Analytics 4 measurement ID. Loaded only after cookie consent.
# Google Analytics 4 Measurement ID. Loaded only after cookie consent.
VITE_GA_MEASUREMENT_ID=G-HD46DQXB9H

# Optional public map proxy configuration, only if the map component is enabled.
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# Optional OAuth configuration, only if sign-in is enabled.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
